<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Label="Configure assembly names and namespaces">
    <AssemblyName>DbExceptionClassifier.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <PackageId>DbExceptionClassifier.$(MSBuildProjectName)</PackageId>
    <Version>1.0.2</Version>
    <FileVersion>1.0.2</FileVersion>
    <AssemblyVersion>1.0.2</AssemblyVersion>
    <PackageReleaseNotes>- PostgreSQL: classify RESTRICT violations (SQLSTATE 23001) as reference constraint errors
- Update MySqlConnector to 2.6.1 (fixes GHSA-473q-m89c-ghf8)
- Update Microsoft.Data.Sqlite to 10.0.11 (pulls SQLitePCLRaw 2.1.12, fixes GHSA-2m69-gcr7-jv3q)
- Update Microsoft.Data.SqlClient to 6.1.8 and reference System.Security.Cryptography.Pkcs 8.0.2 in the Oracle package (fixes GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7)</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="..\..\README.md" />
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
</Project>
