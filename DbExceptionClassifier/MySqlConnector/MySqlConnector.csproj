<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageTags>Exception Database DbException ADO.NET MySQL MySqlConnector Pomelo</PackageTags>
    <Description>Classify MySQL database exceptions by error type such as unique constraint violation, foreign key violation, and more. Use this package if you use MySqlConnector, including with MySqlConnector-based EF Core providers such as Pomelo.EntityFrameworkCore.MySql and its forks</Description>
  </PropertyGroup>

  <PropertyGroup>
    <!-- MySQLExceptionClassifier.cs is shared with the MySql.Data project; this selects the MySqlConnector branch. -->
    <DefineConstants>$(DefineConstants);MYSQLCONNECTOR</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <!-- First release under this ID; overrides the shared 1.0.2 notes in DbExceptionClassifier/Directory.Build.props. -->
    <PackageReleaseNotes>- Renamed from DbExceptionClassifier.MySQL.Pomelo: the package only depends on the MySqlConnector driver, not on Pomelo.
  The classifier class is now MySqlConnectorExceptionClassifier in the DbExceptionClassifier.MySqlConnector namespace.
- Same classification logic as DbExceptionClassifier.MySQL.Pomelo 1.0.2 (MySqlConnector 2.6.1, fixes GHSA-473q-m89c-ghf8).</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\MySQL\MySQLExceptionClassifier.cs" Link="MySQLExceptionClassifier.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
  </ItemGroup>

</Project>
