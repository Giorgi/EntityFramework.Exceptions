<Project>
  <PropertyGroup Label="Configure assembly names and namespaces">
    <!-- Not $(SolutionName): dotnet test in Microsoft.Testing.Platform mode evaluates the project without a solution -->
    <AssemblyName>EntityFramework.Exceptions.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
  </PropertyGroup>
</Project>