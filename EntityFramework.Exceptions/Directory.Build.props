<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Label="Configure assembly names and namespaces">
    <AssemblyName>EntityFrameworkCore.Exceptions.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <PackageId>EntityFrameworkCore.Exceptions.$(MSBuildProjectName)</PackageId>
    <Version>11.0.0</Version>
    <FileVersion>11.0.0</FileVersion>
    <AssemblyVersion>11.0.0</AssemblyVersion>
    <PackageReleaseNotes>- Update to .NET 11 and Entity Framework Core 11</PackageReleaseNotes>
  </PropertyGroup>
</Project>
