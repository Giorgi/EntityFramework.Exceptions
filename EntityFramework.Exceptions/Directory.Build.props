<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Label="Configure assembly names and namespaces">
    <AssemblyName>EntityFrameworkCore.Exceptions.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <PackageId>EntityFrameworkCore.Exceptions.$(MSBuildProjectName)</PackageId>
    <Version>10.0.2</Version>
    <FileVersion>10.0.2</FileVersion>
    <AssemblyVersion>10.0.2</AssemblyVersion>
    <PackageReleaseNotes>- PostgreSQL: throw ReferenceConstraintException for RESTRICT violations (SQLSTATE 23001)
- Depend on DbExceptionClassifier 1.0.2: security updates for Microsoft.Data.SqlClient, Microsoft.Data.Sqlite and System.Security.Cryptography.Pkcs (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7, GHSA-2m69-gcr7-jv3q)</PackageReleaseNotes>
  </PropertyGroup>
</Project>
