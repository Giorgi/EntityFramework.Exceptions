<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Label="Configure assembly names and namespaces">
    <AssemblyName>EntityFrameworkCore.Exceptions.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <PackageId>EntityFrameworkCore.Exceptions.$(MSBuildProjectName)</PackageId>
    <Version>10.0.2</Version>
    <FileVersion>10.0.2</FileVersion>
    <AssemblyVersion>10.0.2</AssemblyVersion>
    <PackageReleaseNotes>- Update MySqlConnector to 2.6.1 in the Pomelo package (fixes GHSA-473q-m89c-ghf8)</PackageReleaseNotes>
  </PropertyGroup>
</Project>
