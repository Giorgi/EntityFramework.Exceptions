<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Label="Configure assembly names and namespaces">
    <AssemblyName>EntityFrameworkCore.Exceptions.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <PackageId>EntityFrameworkCore.Exceptions.$(MSBuildProjectName)</PackageId>
    <Version>11.0.0</Version>
    <FileVersion>11.0.0</FileVersion>
    <AssemblyVersion>11.0.0</AssemblyVersion>
    <PackageReleaseNotes>- Update to .NET 11 and Entity Framework Core 11
- Add UseExceptionProcessor overload that accepts a custom IDbExceptionClassifier
- Populate ConstraintName and ConstraintProperties for alternate key violations
- Fix constraint details when one constraint name contains another (for example IX_Users and IX_Users_Name): the longest matching name is now used
- Add EntityFrameworkCore.Exceptions.MySqlConnector for EF Core providers built on MySqlConnector, such as Pomelo.EntityFrameworkCore.MySql and Microting.EntityFrameworkCore.MySql. It replaces EntityFrameworkCore.Exceptions.MySQL.Pomelo, which is discontinued</PackageReleaseNotes>
  </PropertyGroup>
</Project>
